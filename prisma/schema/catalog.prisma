/// Marketing catalogue entry (product, solution or service) used to generate brochures and presentations.
/// List fields are plain text, one entry per line; specs lines are "Label: value".
model CatalogItem {
  id           String    @id @default(cuid())
  companyId    String
  code         String?
  name         String
  kind         String    @default("product") // product | solution | service
  category     String?
  tagline      String?
  summary      String?   @db.Text
  description  String?   @db.Text
  features     String?   @db.Text
  specs        String?   @db.Text
  benefits     String?   @db.Text
  applications String?   @db.Text
  /// Attachment ids; the first image is the hero/cover image
  images       Json?
  productId    String?
  price        Decimal?  @db.Decimal(18, 2)
  showPrice    Boolean   @default(false)
  /// This item's own brochure page (HTML) and styling (CSS, applied to this item's pages only)
  customHtml   String?   @db.Text
  customCss    String?   @db.Text
  status       String    @default("draft") // draft | published
  custom       Json?
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([companyId, status])
  @@index([category])
}
