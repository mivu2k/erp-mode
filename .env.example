DATABASE_URL=mysql://erp:erp@localhost:3306/erp
WEB_URL=http://localhost:3000
FIELD_ENCRYPTION_KEY=change-me-32+-random-chars
JWT_ACCESS_SECRET=change-me-access
ACCESS_TTL=15m
REFRESH_TTL_DAYS=14
CORS_ORIGINS=http://localhost:3000
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio12345
SEED_ADMIN_EMAIL=admin@erp.local
SEED_ADMIN_PASSWORD=Admin@12345
MINIO_BUCKET=erp
# Headless Chromium for PDF (Docker image sets it); leave empty to disable server PDF
CHROME_PATH=
# JOBS=off disables the background job runner on this instance
# s3 = MinIO/S3 (docker compose sets this); anything else = local folder UPLOAD_DIR
STORAGE=local
UPLOAD_DIR=uploads
# Logins per IP per minute (raise only for automated test runs)
LOGIN_RATE_LIMIT=10
